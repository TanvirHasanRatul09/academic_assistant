{
  "name": "academic-assistant-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "test": "vitest run",
    "check:budgets": "node scripts/check-budgets.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": ">=4.4.0 <7",
    "react": ">=19.0.0 <20",
    "react-dom": ">=19.0.0 <20",
    "react-router-dom": ">=7.1.0 <8",
    "vite": ">=6.0.0 <9",
    "vite-plugin-pwa": ">=0.31.0 <2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": ">=9.17.0 <11",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": ">=6.6.0 <8",
    "@testing-library/react": ">=16.1.0 <17",
    "@types/react": ">=19.0.0 <20",
    "@types/react-dom": ">=19.0.0 <20",
    "axe-core": "^4.13.0",
    "eslint": ">=9.17.0 <11",
    "eslint-plugin-react-hooks": ">=5.2.0 <8",
    "eslint-plugin-react-refresh": ">=0.4.16 <1",
    "globals": ">=15.14.0 <18",
    "jsdom": ">=25.0.0 <31",
    "typescript": ">=5.7.0 <8",
    "typescript-eslint": ">=8.19.0 <9",
    "vitest": ">=3.0.0 <6"
  }
}
