# development | test | preview | production (required)
APP_ENV=development
# Secret. Local Docker Compose example only; use pooled TLS Neon URL in production.
DATABASE_URL=postgresql+psycopg://academic_app:local-development-only@localhost:5432/academic_assistant
# Secret, optional locally. Use a direct TLS URL and migration-only role in production.
MIGRATION_DATABASE_URL=
# Secret, required. Generate independently: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# Secret, required. Generate independently; a valid Fernet key will be required before token storage.
TOKEN_ENCRYPTION_KEY=replace-with-an-independent-encryption-key
# Public identifier, required for OAuth environments.
GOOGLE_CLIENT_ID=replace-with-environment-specific-client-id
# Secret, required for OAuth environments.
GOOGLE_CLIENT_SECRET=replace-with-environment-specific-client-secret
# Public callback URL, required.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Exact comma-separated browser origins, required. Wildcards are rejected.
ALLOWED_ORIGINS=http://localhost:5173
# Secret and optional until the AI milestone.
GEMINI_API_KEY=

# Optional model override for the AI assistant.
GEMINI_MODEL=gemini-2.5-flash

# in_process for local development; worker for durable production execution.
SYNC_EXECUTION_MODE=in_process

